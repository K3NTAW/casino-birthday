# Copy to .env.local and fill in. NEVER commit real keys.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key. Shared among all guests for the night — see README trust model.
VITE_SUPABASE_ANON_KEY=

# NOTE: there is deliberately NO admin code here. It would end up in the JS
# bundle that ships to every guest's phone. The host code lives ONLY in the
# database (app_secrets.admin_code, set by 0003_seed.sql) and is verified
# server-side. The host just types it at runtime. To change it:
#   update app_secrets set admin_code = 'your-code' where id = 1;
